# Required. Generate independent random values; never reuse these examples.
JWT_SECRET=
PROMETHEUS_ADMIN_PASSWORD=

# The deterministic Jac agent is the production default.
SAFERELAY_LIVE_AGENT=false
BYLLM_DEFAULT_MODEL=gpt-4o-mini
MAPBOX_ACCESS_TOKEN=

# Set exactly the provider credential used by BYLLM_DEFAULT_MODEL.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Only configure these before raising max_replicas above 1.
# MONGODB_URI=
# REDIS_URL=
